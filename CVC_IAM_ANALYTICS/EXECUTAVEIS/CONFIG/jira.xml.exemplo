<?xml version="1.0" encoding="UTF-8"?>
<!--
  MODELO. Copie para 'jira.xml' NA PASTA DE REDE e preencha:

      <rede><raiz>\EXECUTAVEIS\CONFIG\jira.xml

  O painel LE DIRETO DA REDE a cada abertura, sem copia local. Isso significa
  que trocar o token aqui vale para todos os analistas na proxima vez que
  abrirem o painel — sem republicar versao, sem passar por release.

  Sem <rede><raiz> (modo local / dev), o painel le o jira.xml ao lado deste
  arquivo.

  ESTE ARQUIVO NAO VAI PARA O GIT: 'jira.xml' esta no .gitignore. O modelo
  (.exemplo) e' versionado; o preenchido, nunca.

  A conta deve ser uma CONTA DE SERVICO cadastrada como CLIENTE do portal —
  nunca a conta pessoal de um analista. Ela so precisa abrir chamado; nao
  transiciona, nao fecha, nao le dado de outro projeto.
-->
<jira>

    <!-- false = botao "Abrir chamado no Jira" fica desabilitado no painel.
         Mesmo com true, sem usuario/token ele continua desabilitado. -->
    <ativo>false</ativo>

    <!-- Credencial (infra) -->
    <usuario>svc-iam@cvccorp.com.br</usuario>
    <token>COLE_O_API_TOKEN_AQUI</token>

    <!-- Servidor e formulario. Estes valores foram apurados na API em 10/08/2026
         e so mudam se o Jira for reconfigurado do lado da CVC. -->
    <url>https://cvccorp.atlassian.net</url>
    <service_desk_id>9</service_desk_id>
    <request_type_id>8819</request_type_id>

    <!-- Campo "Caracteristicas de Solicitacao" (obrigatorio no formulario 8819)
         e o valor fixo que ele recebe. -->
    <campo_tipo>customfield_11936</campo_tipo>
    <tipo_solicitacao>Revogação de acessos</tipo_solicitacao>

    <!-- Prefixo do titulo do chamado:
         "<prefixo> - <SISTEMA> - <NOME DO USUARIO>" -->
    <prefixo_titulo>Sanitização</prefixo_titulo>

    <timeout_s>30</timeout_s>

    <!-- MODO TESTE — abre o chamado, devolve o numero para a tela e CANCELA
         em seguida. Serve para exercitar o caminho inteiro (permissao,
         formulario, campos, numero de volta) sem deixar chamado de teste na
         fila de quem atende.

         true  = abre e cancela  (testes seus e da Bruna)
         false = opera normalmente, o chamado FICA ABERTO  (producao)

         DEIXAR true EM PRODUCAO E' O PIOR ERRO POSSIVEL AQUI: todo chamado
         nasceria e morreria, ninguem revogaria nada, e a tela mostraria
         "aberto" com o numero certo. Nao ha erro visivel — so' o log do
         visualizador avisa, em caixa alta, na linha "Jira". -->
    <cancelar_apos_abrir>false</cancelar_apos_abrir>

    <!-- Id da transicao de cancelamento no workflow (261 neste tenant).
         So' e' usado quando cancelar_apos_abrir = true. -->
    <transicao_cancelamento>261</transicao_cancelamento>

    <!-- COMPONENTE(S) do chamado — e' o que decide EM QUAL FILA ele cai. As
         filas do service desk filtram por `component`, nao por tipo de
         solicitacao: chamado sem componente nao aparece em fila nenhuma.

         Aceita id ou nome, separados por virgula. Ex.:
             <componentes>12165</componentes>
             <componentes>7 - Gestao de Acessos - Desligamento</componentes>

         VAZIO = nao vai no payload (comportamento validado hoje).

         QUAL PREENCHER E' DECISAO DA AREA, NAO TECNICA. Os dois candidatos
         apontam para lados opostos:
             11681  5 - Gestao de Acessos - Revogacoes   fila 1231 — 0 abertos
             12165  7 - Gestao de Acessos - Desligamento fila 1517 — 31 abertos
         A 5 e' a que o nome sugere (o fluxo e' revogacao), mas esta vazia; a 7
         e' a que a equipe efetivamente opera. Carimbar a errada e' PIOR que
         deixar vazio: o painel passaria a reportar sucesso mandando chamado
         para uma fila que ninguem abre.

         RESSALVA MEDIDA EM 13/08/2026: o formulario 8819 expoe apenas summary,
         description e customfield_11936 — componente NAO aparece na listagem de
         campos. Preencher aqui pode ser recusado pelo portal (a mensagem de erro
         vai inteira para a tela, e nenhum chamado e' criado). A saida definitiva
         e' o 8819 atribuir o componente por valor padrao ou por automacao.
         Conferir SEMPRE pela FILA, nunca lendo o chamado: a conta nao le pela
         API generica o chamado que ela mesma abre pelo portal. -->
    <componentes></componentes>

</jira>
