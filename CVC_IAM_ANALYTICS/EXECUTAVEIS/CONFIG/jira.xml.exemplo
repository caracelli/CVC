<?xml version="1.0" encoding="UTF-8"?>
<!--
  MODELO. Copie para 'jira.xml' NA PASTA DE REDE e preencha:

      <rede><raiz>\EXECUTAVEIS\CONFIG\jira.xml

  O painel LE DIRETO DA REDE a cada abertura, sem copia local. Isso significa
  que trocar o token aqui vale para todos os analistas na proxima vez que
  abrirem o painel — sem republicar versao, sem passar por release.

  Sem <rede><raiz> (modo local / dev), o painel le o jira.xml ao lado deste
  arquivo.

  ESTE ARQUIVO NAO VAI PARA O GIT: 'jira.xml' esta no .gitignore. O modelo
  (.exemplo) e' versionado; o preenchido, nunca.

  A conta deve ser uma CONTA DE SERVICO cadastrada como CLIENTE do portal —
  nunca a conta pessoal de um analista. Ela so precisa abrir chamado; nao
  transiciona, nao fecha, nao le dado de outro projeto.
-->
<jira>

    <!-- false = botao "Abrir chamado no Jira" fica desabilitado no painel.
         Mesmo com true, sem usuario/token ele continua desabilitado. -->
    <ativo>false</ativo>

    <!-- Credencial (infra) -->
    <usuario>svc-iam@cvccorp.com.br</usuario>
    <token>COLE_O_API_TOKEN_AQUI</token>

    <!-- Servidor e formulario. Estes valores foram apurados na API em 10/08/2026
         e so mudam se o Jira for reconfigurado do lado da CVC. -->
    <url>https://cvccorp.atlassian.net</url>
    <service_desk_id>9</service_desk_id>
    <request_type_id>8819</request_type_id>

    <!-- Campo "Caracteristicas de Solicitacao" (obrigatorio no formulario 8819)
         e o valor fixo que ele recebe. -->
    <campo_tipo>customfield_11936</campo_tipo>
    <tipo_solicitacao>Revogação de acessos</tipo_solicitacao>

    <!-- Prefixo do titulo do chamado:
         "<prefixo> - <SISTEMA> - <NOME DO USUARIO>" -->
    <prefixo_titulo>Sanitização</prefixo_titulo>

    <timeout_s>30</timeout_s>

</jira>
