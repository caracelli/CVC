<?xml version='1.0' encoding='UTF-8'?>
<configuracao>
    <versao>1.0.0</versao>
    <cliente>CVC</cliente>
    <projeto>IAM Analytics</projeto>

    <!-- Rede: raiz do compartilhamento (UNICO caminho absoluto). ENTRADA,
         DADOS, INTERACOES e EXECUTAVEIS sao resolvidos sob esta raiz.
         <raiz> vazio = modo local (dev / maquina unica).
         A <versao> acima governa o auto-update local x rede dos executaveis. -->
    <rede>
        <raiz>\\intra.cvc\fscvc\Processos_Antlia\CVC\CVC_IAM\ANALYTICS</raiz>
        <entrada>ENTRADA</entrada>
        <banco_dados>DADOS/BANCO/iam_analytics.db</banco_dados>
        <saidas>DADOS/SAIDAS</saidas>
        <processados>DADOS/PROCESSADOS</processados>
        <erros>DADOS/ERROS</erros>
        <logs>DADOS/LOGS</logs>
        <executaveis>EXECUTAVEIS</executaveis>
        <interacoes>INTERACOES</interacoes>
    </rede>

    <rh>
        <ativos>
            <caminho>ENTRADA/RH/ATIVOS</caminho>
            <!-- Fase 1 (entrega p/ homologacao): terceiros EM ESCOPO — validados
                 por espelho (Empresa+Supervisor), em todos os sistemas. -->
            <processar_terceiros>true</processar_terceiros>
            <colunas>
                <matricula>MATRICULA</matricula>
                <nome>NOME</nome>
                <cpf>CPF</cpf>
                <cargo_codigo>CARGO_CODIGO</cargo_codigo>
                <cargo_descricao>CARGO_DESCRICAO</cargo_descricao>
                <departamento>DEPARTAMENTO</departamento>
                <centro_custo>CENTRO_CUSTO</centro_custo>
                <data_admissao>DATA_ADMISSAO</data_admissao>
                <email>EMAIL</email>
                <situacao>SITUACAO</situacao>
            </colunas>
        </ativos>
        <desligados>
            <!-- Motor de desligados ATIVO: o Processador le a pasta de desligados,
                 popula rh_desligados e a RegraAcessoDesligado gera as divergencias
                 ACESSO_DESLIGADO (desligado com acesso ainda ativo/nao-bloqueado).
                 OBS: sem corte temporal (A3 pendente com a area) — sinaliza TODO
                 desligado com acesso ativo, independente da data de desligamento. -->
            <processar>true</processar>
            <caminho>ENTRADA/RH/DESLIGADOS</caminho>
            <colunas>
                <matricula>MATRICULA</matricula>
                <nome>NOME</nome>
                <cpf>CPF</cpf>
                <data_desligamento>DATA_DESLIGAMENTO</data_desligamento>
                <motivo>MOTIVO</motivo>
            </colunas>
        </desligados>
        <!-- Diretorio AD (Active Directory) por OU: franqueados e prestadores.
             Da dono aos acessos orfaos (sem vinculo RH/terceiro) pela chave LOGIN
             (usuario/CD_LOGIN do extrato == Login do AD). A populacao e' roteada
             pelo NOME do arquivo: OU_Franq* = franqueado, OU_Prest* = prestador,
             OU_Desligados* = desligado (B2 decidido SIM em 29/07 — alimenta
             rh_desligados pelo login e o motor de acesso de desligado). -->
        <diretorio_ad>
            <processar>true</processar>
            <!-- Desde a entrega de 05/08/2026 o cliente separa os exports por
                 POPULACAO, cada pasta com subpastas por mes (07-2026, 08-2026).
                 Aceita varios <caminho>; a varredura e' recursiva. O primeiro
                 e' o formato antigo, mantido para bases ja existentes. A
                 classificacao continua vindo do NOME do arquivo (franq/prest/
                 deslig), nao da pasta. -->
            <caminho>ENTRADA/RH/AD</caminho>
            <caminho>ENTRADA/SISTEMAS/AD_FRANQUEADOS</caminho>
            <caminho>ENTRADA/SISTEMAS/AD_PRESTADORES</caminho>
            <caminho>ENTRADA/SISTEMAS/AD_DESLIGADOS</caminho>
        </diretorio_ad>
    </rh>

    <!-- Regras de validacao que a area pode ligar/desligar sem mexer no codigo. -->
    <validacao>
        <!-- PERFIL EXCESSIVO: pessoa que tem o perfil esperado MAIS outros que a
             matriz nao preve. O excesso SEMPRE aparece na Consulta (a linha
             mostra "N a mais: ..." e um "?" explicando). Esta flag decide se ele
             tambem COBRA acao: com true, a linha deixa de ser "Aderente" e vira
             "Em Analise".
             Medido em 28/08/2026 nos 7 sistemas: 130 casos, 186 perfis extras
             (ORACLE_EBS 96 - SYSTUR 33 - IC 1). Ligar transforma esses 130 em
             pendencia de uma vez; por isso o default e' false.
             (A medida anterior, 196/2.153, estava errada: comparava cada acesso
             contra a UNICA string perfil_esperado da linha, e nao contra o
             conjunto esperado inteiro, que na CCO vem de cc+gestor.) -->
        <perfil_excessivo>
            <gera_pendencia>false</gera_pendencia>
        </perfil_excessivo>

        <!-- MAIS DE UM PERFIL: a pessoa tem mais de um perfil NO MESMO sistema.
             Diferente do perfil excessivo acima: nao importa se a matriz preve
             os dois: a regra da area e' UM perfil por pessoa por sistema.
             Retorno da area (22/09/2026, textual): "Mais de um perfil nao pode
             ficar nada como aderente, ele precisa vir como pendencia para
             analise". Com true, a linha que seria Aderente vira Em Analise com
             motivo MAIS_DE_UM_PERFIL.
             `sistemas` vazio = TODOS os sistemas (escolha do usuario em
             22/09/2026). Para restringir, liste os IDs separados por virgula
             (ex.: SYSTUR).
             Medido em 22/09/2026 na base de 15/09: 419 linhas hoje Aderentes
             viram pendencia (SIG 197, ORACLE_EBS 164, SYSTUR 58); as
             pendencias passam de 826 para 1.245. Restringindo a SYSTUR seriam
             58. -->
        <!-- LIMIAR DE INCLUSAO (regra B1). Adesao minima do CARGO ao sistema
             para a aplicacao sugerir a inclusao de um acesso que a matriz
             preve. ZERO desliga a regra; ausente = 0,30.

             HISTORIA, porque o valor mudou de sentido no meio do caminho:
             nasceu em 25/06/2026 com uma justificativa unica — "nao inundar a
             fila de pendencias" com esperado irrelevante. Em 29/07 a area
             pediu que "sem acesso" saisse das pendencias e ficasse so' na
             Consulta; dali em diante o limiar passou a cortar informacao que
             nao entra em fila nenhuma.
             A area cobrou o efeito tres vezes (10/08, 25/08 e 17/09) e de novo
             em 22/09. Em 23/09/2026 ficou decidido: para os sistemas com
             matriz, trazer 100% do que esta mapeado.

             Medido em 22/09 na base de 15/09, ao zerar: as PENDENCIAS NAO
             sobem (Alterar Perfil 318 e Em Analise 927 ficam identicos);
             Incluir Acesso vai de 3.682 para 6.790 e Nao Mapeado cai de 589
             para 216. 773 pessoas passam a mostrar o que a matriz preve,
             sendo 335 que so' tinham a linha "Nao Mapeado".
             O SIG nao e' afetado: ele nao tem matriz e nunca passou por esta
             regra (874 linhas antes e depois). -->
        <limiar_inclusao>
            <adesao_minima>0</adesao_minima>
        </limiar_inclusao>

        <mais_de_um_perfil>
            <gera_pendencia>true</gera_pendencia>
            <sistemas></sistemas>
            <!-- Sistemas em que ter varios perfis e' NORMAL e NAO vira
                 pendencia. ORACLE_EBS entrou em 23/09/2026: "no oracle cada
                 perfil e' um acesso especifico ao sistema" — contar isso como
                 "um a mais" fazia virar pendencia quem tem exatamente o que a
                 funcao dela preve. Caso medido: matricula 90001455, 4 perfis
                 Oracle, todos da funcao "Atendimento a fornecedores CVC e
                 VISUAL". -->
            <sistemas_fora>ORACLE_EBS</sistemas_fora>
        </mais_de_um_perfil>

        <!-- ANCORA NO PERFIL DO SYSTUR (area, 23/09/2026), textual:
             "ele so pode ter os acessos oracle se o perfil bater com o systur
              que ele tem, se no systur nao vier perfil e pendencia systur, se
              no oracle o perfil ou acesso divergir do systur e pendencia
              oracle".

             A matriz do Oracle tem a coluna PERFIL SYSTUR (39 valores, 38 deles
             existindo literalmente como perfil no extrato do SYSTUR) e ela era
             lida e DESCARTADA. Sem ela a pessoa recebia todas as
             responsabilidades do cargo+CC, sem olhar o SYSTUR.

             A CCO entra pelo outro lado: as linhas de sistema 'Systur' dela
             traduzem o nome tecnico do perfil para o nome humano da funcao
             (A_RECEBER_1 <-> "A Receber 1"), e e por essa ponte que o perfil
             do SYSTUR chega nos acessos Oracle que a funcao preve.

             Medido em 23/09/2026 na base de 15/09, nas 457 pessoas com Oracle
             vivo: 190 sem perfil no SYSTUR (pendencia no SYSTUR), 106 com
             perfil que matriz nenhuma conhece, 99 divergentes, 17 a incluir e
             45 aderentes (eram 13 antes de juntar as duas matrizes).

             Vazio desliga a regra. -->
        <ancora_systur>
            <sistemas>ORACLE_EBS</sistemas>
            <!-- Acessos corporativos que matriz nenhuma prescreve e que NAO
                 contam como divergencia (casam por prefixo). VAZIO por decisao
                 de 23/09: o 'CVC OIE BRASIL - RELATORIO DE DESPESAS' esta em
                 373 das 457 pessoas e 278 tem so ele — preenchendo aqui, a
                 pendencia do Oracle cai de 99 para 18 pessoas e os aderentes
                 sobem de 45 para 69, sem rebuild. -->
            <perfis_isentos></perfis_isentos>
        </ancora_systur>

        <!-- CONTA DE SERVICO nos DESLIGADOS (retorno da area, 28 e 31/08/2026):
             "porque ta vindo uns usuarios sistemicos nos desligados".
             O robo e' cadastrado com o e-mail de quem o criou; quando essa
             pessoa e' desligada, o robo aparece como acesso a revogar. Revogar
             derruba producao.

             O acesso com um destes prefixos de LOGIN deixa de entrar na lista de
             revogacao e passa a uma categoria propria — ele NAO some: some da
             cobranca, continua consultavel, para que uma classificacao errada
             apareca em vez de se esconder.

             Medido em 31/08/2026 nas 432 linhas de ACESSO_DESLIGADO (E2E dos 7
             sistemas): `SIST` pega 297 (69%). Zero falso positivo (nenhum SIST*
             parece pessoa: ROBO MARITIMO, AUTOMACAO RPA SOLO, PROJETO JENKINS,
             ROBO AEREO GRUPOS, ROBO POS TRAVEL B2B, ROBO REEMBOLSO AO CLIENTE...)
             e zero robo fora do prefixo.

             PARA MANTER: acrescente prefixos separados por virgula quando a CVC
             criar contas de servico com outra nomenclatura. Reprocessar basta —
             nao precisa de executavel novo. Para desligar a regra sem perder a
             lista, use <excluir_de_desligados>false</excluir_de_desligados>. -->
        <!-- CONTA PENDENTE: acesso cujo status no extrato nao diz se a conta
             esta ativa ('P'/pendente ou vazio). Ate 31/08 isso virava "Em
             Analise" com uma explicacao no "?".

             Retorno da area (31/08/2026), textual: "Considerar apenas os
             acessos ativos: se a pessoa estiver com acesso nesse status,
             inativo, bloqueado ou P, e ela poder ter o acesso, trazer como a
             incluir e o perfil que pode ser liberado para ela." Ela mandou o
             print do proprio "?" perguntando "os perfis estao iguais, nao
             deveria estar aderente?" — explicar nao bastou, ela quer outro
             desfecho.

             Com true, a linha vira "Incluir Acesso" mostrando o perfil
             LIBERAVEL. Bloqueado/inativo ja se comportavam assim
             (CONTA_BLOQUEADA); isto fecha o 'P'.
             Medido em 31/08 no E2E dos 7 sistemas: 11 linhas mudam.
             False volta ao comportamento de 10/08, sem build novo. -->
        <conta_pendente>
            <vira_inclusao>true</vira_inclusao>
        </conta_pendente>

        <!-- FRANQUEADO por MATRIZ propria (cargo x tipo de atendimento x tipo
             de loja) — pedido da area em 31/08/2026: "para franqueado nao tem
             a questao de espelho".
             A matriz ("MATRIZ DE PERFIL DE ACESSO SYSTUR - LOJAS") fica junto
             das outras, em MATRIZES/PERFIS_SISTEMAS, e e reconhecida pelo
             cabecalho (TIPO DE LOJA / TIPO DE ATENDIMENTO).
             Ela valida ADERENCIA — "o cargo justifica o perfil que a pessoa
             TEM?" — e NAO gera inclusao: TIPO DE LOJA e TIPO DE ATENDIMENTO
             nao existem no cadastro (medido em 01/09: local_trabalho e filial
             100% vazios), entao nao da para dizer QUAL perfil a pessoa deveria
             ter. Quem nao tem acesso, ou tem perfil fora da matriz, continua
             no espelho.
             Os 3 perfis do bloco "Perfis Excecoes" da planilha NAO viram
             esperado: saem como Em Analise citando a Governanca de SI.
             false = franqueado segue so no espelho, como antes de 02/09. -->
        <franqueado>
            <matriz_propria>true</matriz_propria>
        </franqueado>

        <conta_servico>
            <prefixos_login>SIST</prefixos_login>
            <excluir_de_desligados>true</excluir_de_desligados>
        </conta_servico>
    </validacao>

    <sistemas>
        <sistema id="SIGOT">
            <nome>SIGOT</nome>
            <descricao>Sistema de Gestão de Operações e Turismo</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/SIGOT</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/SIGOT</caminho_parquet>
            <!-- Fase 1: fora de escopo (so SYSTUR). ativo=true quando implementado. -->
            <ativo>true</ativo>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
                <data_criacao>DATA_CRIACAO</data_criacao>
                <ultimo_acesso>ULTIMO_ACESSO</ultimo_acesso>
            </colunas>
        </sistema>

        <sistema id="SICA_RA">
            <nome>SICA_RA</nome>
            <descricao>Sistema de Controle de Acesso - Rede Agência</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/SICA_RA</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/SICA_RA</caminho_parquet>
            <!-- Fase 1: fora de escopo (so SYSTUR). ativo=true quando implementado. -->
            <ativo>true</ativo>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
                <data_criacao>DATA_CRIACAO</data_criacao>
                <ultimo_acesso>ULTIMO_ACESSO</ultimo_acesso>
            </colunas>
        </sistema>

        <sistema id="SICA_ESFERA">
            <nome>SICA_ESFERA</nome>
            <descricao>Sistema de Controle de Acesso - Esfera</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/SICA_ESFERA</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/SICA_ESFERA</caminho_parquet>
            <!-- Fase 1 (entrega p/ homologacao): SICA Esfera EM ESCOPO — valida
                 por regra padrao (matriz por cargo + CCO). -->
            <ativo>true</ativo>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
                <data_criacao>DATA_CRIACAO</data_criacao>
                <ultimo_acesso>ULTIMO_ACESSO</ultimo_acesso>
            </colunas>
        </sistema>

        <sistema id="SYSTUR">
            <nome>SYSTUR</nome>
            <descricao>Sistema de Turismo</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/SYSTUR</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/SYSTUR</caminho_parquet>
            <!-- Fase 1: UNICO sistema em escopo. -->
            <ativo>true</ativo>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
                <data_criacao>DATA_CRIACAO</data_criacao>
                <ultimo_acesso>ULTIMO_ACESSO</ultimo_acesso>
            </colunas>
        </sistema>

        <sistema id="IC">
            <nome>IC_INTEGRADOR_CONTABIL</nome>
            <descricao>Integrador Contábil</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/IC</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/IC</caminho_parquet>
            <!-- Em escopo: extrato + matriz integrados. Perfil casa por aproximacao
                 (extrato usa NM_GRUPO com '_'; matriz usa espaco).
                 DESATIVADO temporariamente: IC atrapalhando a validacao do SYSTUR. -->
            <ativo>true</ativo>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
                <data_criacao>DATA_CRIACAO</data_criacao>
                <ultimo_acesso>ULTIMO_ACESSO</ultimo_acesso>
            </colunas>
        </sistema>

        <!-- SIG (Card 12) — extrato matricial pivotado (X = acesso) + de-para
             de codigos em <caminho_de_para>. Despivot acontece no leitor.
             A matriz formal de perfil esperado por cargo NAO existe para SIG
             (gestao "por espelho" + cobertura via Mapeamento CCO_CSC). -->
        <sistema id="SIG">
            <nome>SIG</nome>
            <descricao>SIG</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/SIG</caminho_entrada>
            <caminho_de_para>ENTRADA/MATRIZES/PERFIS_SISTEMAS/SIG/DE_PARA</caminho_de_para>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/SIG</caminho_parquet>
            <!-- Fase 1 (entrega p/ homologacao): SIG EM ESCOPO — validado por
                 ESPELHO dinamico (CC+gestor+cargo, maioria >=70%). -->
            <ativo>true</ativo>
            <colunas>
                <usuario>LOGIN</usuario>
                <nome>NM_USER</nome>
                <cpf>CPF</cpf>
                <email>EMAIL</email>
                <situacao>STATUS</situacao>
            </colunas>
            <formato>matricial</formato>
        </sistema>

        <!-- Oracle EBS (Card 11) — scaffold preparado, arquivo ainda nao recebido.
             Quando o arquivo chegar: ajustar <colunas> e implementar leitor. -->
        <sistema id="ORACLE_EBS">
            <nome>ORACLE_EBS</nome>
            <descricao>Oracle EBS</descricao>
            <caminho_entrada>ENTRADA/SISTEMAS/ORACLE_EBS</caminho_entrada>
            <caminho_parquet>DADOS/PARQUET/ACESSOS/ORACLE_EBS</caminho_parquet>
            <colunas>
                <usuario>USUARIO</usuario>
                <nome>NOME</nome>
                <cpf>CPF</cpf>
                <email>EMAIL</email>
                <perfil>PERFIL</perfil>
                <situacao>SITUACAO</situacao>
            </colunas>
            <ativo>true</ativo>
        </sistema>
    </sistemas>

    <matrizes>
        <organizacional>
            <caminho>ENTRADA/MATRIZES/ORGANIZACIONAL</caminho>
            <colunas>
                <cargo_codigo>CARGO_CODIGO</cargo_codigo>
                <cargo_descricao>CARGO_DESCRICAO</cargo_descricao>
                <departamento>DEPARTAMENTO</departamento>
                <centro_custo>CENTRO_CUSTO</centro_custo>
            </colunas>
        </organizacional>
        <perfis_sistemas>
            <caminho>ENTRADA/MATRIZES/PERFIS_SISTEMAS</caminho>
            <colunas>
                <cargo_codigo>CARGO_CODIGO</cargo_codigo>
                <sistema>SISTEMA</sistema>
                <perfil>PERFIL</perfil>
            </colunas>
        </perfis_sistemas>
    </matrizes>

    <processamento>
        <encoding_padrao>utf-8</encoding_padrao>
        <separador_csv>;</separador_csv>
        <formato_data>%d/%m/%Y</formato_data>
        <mover_processados>true</mover_processados>
        <gerar_relatorio>true</gerar_relatorio>
    </processamento>

    <saidas>
        <divergencias>DADOS/SAIDAS/DIVERGENCIAS</divergencias>
        <desligados>DADOS/SAIDAS/DESLIGADOS</desligados>
        <transferidos>DADOS/SAIDAS/TRANSFERIDOS</transferidos>
        <auditoria>DADOS/SAIDAS/AUDITORIA</auditoria>
        <logs>DADOS/LOGS</logs>
    </saidas>

    <!-- Metas / thresholds do painel (KRI). Opcionais: ausente/vazio = KPI sem
         selo. acessos_desligado_meta = limite tolerado de desligados com acesso
         ativo (risco). 0 = ideal (nenhum); qualquer valor acima acende o alerta. -->
    <metas>
        <acessos_desligado_meta>0</acessos_desligado_meta>
    </metas>

    <!-- Visualizador: escopo (sistema) e prazo da quarentena.
         O banco e lido de rede/banco_dados acima. -->
    <visualizador>
        <!-- Escopo do painel: vazio = TODOS os sistemas ativos (SYSTUR + IC).
             Preencher com um id (ex.: SYSTUR) para limitar a um sistema so. -->
        <sistema></sistema>
        <quarentena_dias>90</quarentena_dias>

        <!-- OCIOSIDADE (area, 23/09/2026): "o programa ainda fica dando erro ao
             pular as janelas, ai precisa ficar fechando e abrindo ele de novo".
        
             O painel manda um sinal de vida a cada 4 s, mas o navegador CONGELA a
             aba quando a janela fica atras de outra (guias em suspensao do Edge,
             congelamento do Chrome) — e a maquina bloqueada para tudo. Com o valor
             antigo, 300, bastavam 5 minutos fora para o servidor encerrar: a aba
             seguia aberta e tudo passava a dar erro.
        
             Fechar a pagina continua encerrando na hora (o beacon do pagehide nao
             depende deste relogio). Este numero so cobre o caso anormal: navegador
             morto sem avisar. 0 desliga o encerramento por ociosidade. -->
        <ociosidade_segundos>28800</ociosidade_segundos>
    </visualizador>

    <!-- A configuracao do Jira (Cards 25-26) NAO fica aqui: vive em
         CONFIG/jira.xml, arquivo proprio preenchido pela INFRA e NAO versionado
         (carrega o token). Modelo em CONFIG/jira.xml.exemplo.
         Sem esse arquivo, o botao "Abrir chamado no Jira" segue desabilitado. -->
</configuracao>
