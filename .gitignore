# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/

# Dados de entrada (arquivos do cliente — não versionados)
CVC_IAM_ANALYTICS/ENTRADA/**/*.csv
CVC_IAM_ANALYTICS/ENTRADA/**/*.CSV
CVC_IAM_ANALYTICS/ENTRADA/**/*.xlsx
CVC_IAM_ANALYTICS/ENTRADA/**/*.xls

# Saídas geradas
CVC_IAM_ANALYTICS/DADOS/SAIDAS/**/*.csv
CVC_IAM_ANALYTICS/DADOS/SAIDAS/**/*.xlsx
CVC_IAM_ANALYTICS/DADOS/SAIDAS/**/*.pdf

# Banco de dados
CVC_IAM_ANALYTICS/DADOS/BANCO/*.db
CVC_IAM_ANALYTICS/DADOS/BANCO/*.bak*
CVC_IAM_ANALYTICS/DADOS/BANCO/*.sqlite
CVC_IAM_ANALYTICS/DADOS/BANCO/*.db-shm
CVC_IAM_ANALYTICS/DADOS/BANCO/*.db-wal

# Parquet — descartado: o visualizador le o SQLite direto (sem Power BI)
CVC_IAM_ANALYTICS/DADOS/PARQUET/

# Arquivos processados e de erro
CVC_IAM_ANALYTICS/DADOS/PROCESSADOS/
CVC_IAM_ANALYTICS/DADOS/ERROS/

# Interacoes multiusuario (pasta de rede; copias locais nunca versionadas)
CVC_IAM_ANALYTICS/INTERACOES/
CVC_IAM_ANALYTICS/INTERACOES_processando/

# Logs
CVC_IAM_ANALYTICS/DADOS/LOGS/

# IDEs
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Executaveis gerados (v2.0+: 2 principais + 3 launchers, gerados via build_all.py)
CVC_IAM_ANALYTICS/EXECUTAVEIS/*.exe
CVC_IAM_ANALYTICS/EXECUTAVEIS/launcher/*.exe
CVC_IAM_ANALYTICS/EXECUTAVEIS/launcher/*.old

# DADOS local (cache do banco, logs do visualizador, .old do auto-update)
CVC_IAM_ANALYTICS/EXECUTAVEIS/DADOS/
CVC_IAM_ANALYTICS/EXECUTAVEIS/visualizador_log.txt
CVC_IAM_ANALYTICS/EXECUTAVEIS/*.old
CVC_IAM_ANALYTICS/EXECUTAVEIS/*.db
CVC_IAM_ANALYTICS/EXECUTAVEIS/*.db-wal
CVC_IAM_ANALYTICS/EXECUTAVEIS/*.db-shm

# Artefatos de build PyInstaller
deploy/_build/
deploy/_build_visualizador/

# Staging temporario dos builds de entrega (criados/removidos pelos build_*.py)
/_update_staging/
/_entrega_prd_staging/
/_entrega_rede_staging/

# Zips de entrega — VERSIONADOS via Git LFS (ver .gitattributes), para pull
# pronto na maquina de deploy. Regra: limpar os zips antigos e gerar os novos
# a cada release (nao acumular). Gerados por build_all.py + build_entrega_rede.py.
# Pastas EXTRAIDAS de pacotes em ENTREGA/ nao entram no git (so os .zip/.docx) —
# evita commitar exes descompactados por engano.
ENTREGA/*/

# Configurações locais do Claude
.claude/

# Arquivos antigos / obsoletos — movidos para limpeza, fora do versionamento
OLD/

# Power BI — arquivos locais e cache (não versionados)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Cache local do visualizador (caminho do PBIDesktop.exe por maquina)
CVC_IAM_ANALYTICS/.pbi_local

# Log de execucao do visualizador — versionado para diagnostico remoto
# src/visualizador/visualizador_log.txt
src/DADOS/
_commit_msg.txt
